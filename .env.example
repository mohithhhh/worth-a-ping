# Caspian API Configuration
# Get your API key from https://trycaspianai.com
CASPIAN_API_KEY=your_caspian_api_key_here
CASPIAN_BASE_URL=https://api.trycaspianai.com

# Gemini API Configuration
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Your Telegram Handle
# This is where urgent alerts will be sent.
# Use your Telegram username (with @) or chat ID.
# Example: @yourusername or 123456789
MY_TELEGRAM_HANDLE=@your_telegram_username
