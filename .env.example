# Caspian API Configuration
# Get your API key from https://trycaspianai.com
CASPIAN_API_KEY=your_caspian_api_key_here
CASPIAN_BASE_URL=https://api.trycaspianai.com

# Gemini API Configuration
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Configuration for Alerts
# Bot token from @BotFather (same one used for caspian connect telegram)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID (numeric ID, not username)
# Get it by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here
